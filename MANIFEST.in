# sdist manifest — ship only what a source build needs.
# setuptools' default sdist filelist pulls in every .py under the project,
# including tests/ (185 files of test-only code).  Prune the dev-only trees
# so the release sdist stays small and clean; the wheel is unaffected (its
# contents come from package-data, not this manifest).
#
# egg-info: with a src/ layout, setuptools defaults to ``src/rebrew.egg-info/``.
# ``[tool.distutils.egg_info] egg_base = "."`` parks it at the project root;
# prune both locations so a stale src/ tree from an older build cannot leak
# PKG-INFO / entry_points / requires.txt.  setuptools still force-appends
# ``SOURCES.txt`` into the sdist after prune — that single file is expected.
prune tests
prune docs
prune tools
prune .agents
prune .github
prune .scratch
prune .cache
prune .hypothesis
prune .mypy_cache
prune .pytest_cache
prune .ruff_cache
prune build
prune dist
prune .venv
prune venv
prune rebrew.egg-info
prune src/rebrew.egg-info
# Top-level docs setuptools already ships (README.md) or the metadata points at
# (Project-URL: Changelog / Security).  A source install reaches neither URL
# offline, so the sdist carries them.  LICENSE and NOTICE come in through
# [project] license-files.
include CHANGELOG.md
include SECURITY.md
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .coverage
global-exclude *.cover
# Subpackage contributor docs — runtime package-data is explicit in pyproject.
recursive-exclude src/rebrew AGENTS.md
