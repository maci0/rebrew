        <mxCell id="b4d" value="&lt;b&gt;--gen-header&lt;/b&gt;&lt;br&gt;src/&amp;lt;t&amp;gt;/rebrew_globals.h&lt;br&gt;externs for the build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
