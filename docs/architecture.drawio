        <mxCell id="s2" value="&lt;b&gt;Data factory&lt;/b&gt;&lt;br&gt;RE Notebook / re-dataset-generator&lt;br&gt;exports JSONL, does not train&lt;br&gt;synthetic sweep yes (25k cap)&lt;br&gt;wild ingest yes; SK² export no&lt;br&gt;factory ingest of --collect-pairs no" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
