        <mxCell id="b6d" value="&lt;b&gt;verify-placement&lt;/b&gt;&lt;br&gt;.data symbol VAs vs metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1520" y="340" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-note" value="Missing an extern shifts every later BSS symbol: one gap cascades into reloc mismatches across the project. Fix the layout, then re-verify functions that were ~~. order-sources orders TUs by first function VA so link order is stable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
