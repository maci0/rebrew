  <diagram id="loop" name="2. Compile-compare loop">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="loop-title" value="Inside rebrew: compile → compare → STATUS (and who may write what)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="src-box" value="Inputs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="300" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="cfile" value="&lt;b&gt;.c / .cpp sources&lt;/b&gt;&lt;br&gt;// FUNCTION: MOD 0xVA&lt;br&gt;file-only: MARKER, VA, MODULE, SYMBOL&lt;br&gt;annotation.py parse_c_file_multi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="toml" value="&lt;b&gt;rebrew-project.toml&lt;/b&gt;&lt;br&gt;targets, compiler profile, paths&lt;br&gt;config.py → ProjectConfig" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="206" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="meta" value="&lt;b&gt;rebrew-functions.toml&lt;/b&gt;&lt;br&gt;STATUS CFLAGS TOOLCHAIN BLOCKER NOTE&lt;br&gt;mode 0444; CLI chmods to write&lt;br&gt;metadata.py + metadata_model.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="302" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="bin" value="&lt;b&gt;target binary&lt;/b&gt;&lt;br&gt;PE / ELF / Mach-O / NE&lt;br&gt;binary_loader.py (LIEF) → bytes at VA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#1e293b;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="408" width="260" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="mid-box" value="Merge and compile" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="380" y="64" width="560" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="merged" value="&lt;b&gt;merged Annotation&lt;/b&gt;&lt;br&gt;merge_into_annotation()&lt;br&gt;metadata wins for owned fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="diag" value="&lt;b&gt;diagnose.py&lt;/b&gt;&lt;br&gt;resolution: per-function TOOLCHAIN/CFLAGS&lt;br&gt;→ nearest rebrew-libraries.toml → project default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="compile" value="&lt;b&gt;compile.py&lt;/b&gt;&lt;br&gt;compile_to_obj → compile_and_compare&lt;br&gt;docker image, or recompile service&lt;br&gt;extract symbol bytes + reloc slots&lt;br&gt;core.matching.smart_reloc_compare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="292" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="cache" value="compile_cache.py&lt;br&gt;SHA-256 keyed disk cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="200" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="tcmod" value="toolchain.py&lt;br&gt;ToolchainSpec + docker run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="200" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="out-box" value="CompareResult and writers" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
