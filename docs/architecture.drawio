        <mxCell id="b3d" value="&lt;b&gt;--fill-data&lt;/b&gt;&lt;br&gt;_dpad_&amp;lt;addr&amp;gt;[N] in .c&lt;br&gt;raw bytes from reference;&lt;br&gt;zero-init in BSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="340" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b4d" value="&lt;b&gt;--gen-header&lt;/b&gt;&lt;br&gt;src/&amp;lt;t&amp;gt;/rebrew_globals.h&lt;br&gt;externs for the build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="340" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b5d" value="&lt;b&gt;calibrate-bss&lt;/b&gt;&lt;br&gt;g_bss_tail in link_stubs.c&lt;br&gt;match .data VirtualSize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="340" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b6d" value="&lt;b&gt;verify-placement&lt;/b&gt;&lt;br&gt;.data symbol VAs vs metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1520" y="340" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-note" value="Missing an extern shifts every later BSS symbol: one gap cascades into reloc mismatches across the project. Fix the layout, then re-verify functions that were ~~. order-sources orders TUs by first function VA so link order is stable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="434" width="1630" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="e-b0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;endArrow=block;" edge="1" parent="1" source="b0" target="b1d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1d4ed8;endArrow=block;" edge="1" parent="1" source="b1d" target="b2d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1d4ed8;endArrow=block;" edge="1" parent="1" source="b1d" target="b3d"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="426"/><mxPoint x="900" y="426"/></Array></mxGeometry></mxCell>

        <!-- layout / postlink -->
        <mxCell id="lay" value="C. Layout package and postlink (linker artifacts, not decomp errors)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="1680" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="l0" value="&lt;b&gt;rebrew gen-layout&lt;/b&gt;&lt;br&gt;from reference PE&lt;br&gt;text-only package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;layout/&amp;lt;target&amp;gt;/&lt;/b&gt;&lt;br&gt;layout.txt  sections, IAT, exports&lt;br&gt;header.hex iat.hex data.hex reloc.hex&lt;br&gt;prefix.hex bookkeeping.hex&lt;br&gt;operands.txt calls.txt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="548" width="280" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;link helpers&lt;/b&gt;&lt;br&gt;gen-link-stubs  BSS TU&lt;br&gt;gen-stubs  unresolved symbols&lt;br&gt;&amp;lt;t&amp;gt;.def  export ordinals&lt;br&gt;link-sweep  LINK.EXE flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="548" width="240" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;round-trip / recomp&lt;/b&gt;&lt;br&gt;splice matched funcs into PE&lt;br&gt;--fix-headers uses [link]&lt;br&gt;naked-fenced sources for reccmp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="548" width="250" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;rebrew postlink&lt;/b&gt;&lt;br&gt;built.dll vs layout/ (or ref)&lt;br&gt;--fix imports | data | pe-metadata | all&lt;br&gt;order: imports → data → pe-metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="548" width="280" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l5" value="&lt;b&gt;byte-identical PE&lt;/b&gt;&lt;br&gt;linker hash/IAT/timestamp&lt;br&gt;normalized away;&lt;br&gt;remaining diff is real code/data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1440" y="548" width="250" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l-note" value="MSVC6 LINK is not a source-order assembler for every section. Placement drift is a linker artifact. The layout package is committed so a public checkout reproduces postlink without original/. Prefix hex is checked for drift, never copied." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="668" width="1630" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="e-l0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="l0" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-l1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-l3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="l1" target="l4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="512"/><mxPoint x="1270" y="512"/></Array></mxGeometry></mxCell>
        <mxCell id="e-l4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ca8a04;endArrow=block;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- how it meets functions -->
        <mxCell id="meet" value="D. How data work feeds function matching" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1680" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="function compile&lt;br&gt;reloc slots point at globals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="808" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="smart_reloc_compare&lt;br&gt;zeros reloc bytes;&lt;br&gt;RELOC if only those differ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="808" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="wrong global VA / BSS gap&lt;br&gt;→ leftover ~~ after mask&lt;br&gt;near-diag: reloc bucket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="808" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="fix data.toml / padding /&lt;br&gt;externs / fill-data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="808" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="re-verify functions&lt;br&gt;STATUS may become RELOC/EXACT&lt;br&gt;without touching the C body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="808" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="coverage.db globals table&lt;br&gt;recoverage paints .data/.bss&lt;br&gt;same defrag grid as .text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="808" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m-note" value="rebrew-data-analysis skill: scan → annotate → dispatch → BSS check → fix-bss / externs → gen-header → lint. Do not use it for function bodies (workflow/matching) or Ghidra field sync (ghidra-sync). recover-structs is a sibling path: typedefs from decompiler offset evidence, not from section bytes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#7c2d12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="894" width="1630" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="e-m0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ea580c;endArrow=block;" edge="1" parent="1" source="m0" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ef4444;endArrow=block;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ca8a04;endArrow=block;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="ml" name="8. LLM training export">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="ml-title" value="What we can ship later for LLM training (collectors vs packaging vs future state)" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1500" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="ml-sub" value="Green = shipped today. Amber = assemble from existing files. Purple dashed = future state (planned, not live). Red = export rules that stay even after those ship." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1650" height="24" as="geometry"/>
        </mxCell>

        <!-- A shipped collectors -->
        <mxCell id="a-lane" value="A. Shipped collectors (opt-in JSONL). These are the only training writers that exist." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1680" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;rebrew match --collect-pairs FILE.jsonl&lt;/b&gt;&lt;br&gt;GA loop: every successful compile appends one line&lt;br&gt;works with --all / --improve / --near-miss&lt;br&gt;&lt;br&gt;{source, compiled_bytes (hex), target_bytes (hex),&lt;br&gt; score, cflags, symbol}&lt;br&gt;&lt;br&gt;score = GA fitness (lower better). Includes misses,&lt;br&gt;not only EXACT. That is the mutation-effect corpus." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="116" width="400" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;recompile POST /api/v1/compile&lt;/b&gt;&lt;br&gt;emit_assembly: true  (default false)&lt;br&gt;MSVC-family adds /FA; first .asm/.cod captured&lt;br&gt;&lt;br&gt;train_data/train.jsonl  (RECOMPILE_TRAIN_DIR)&lt;br&gt;{job_id, compiler, image, filename, flags,&lt;br&gt; source, assembly, time}&lt;br&gt;&lt;br&gt;Best-effort: missing listing skips the sample,&lt;br&gt;never fails the compile. Unauthenticated today." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="116" width="400" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;History files (not a collector flag)&lt;/b&gt;&lt;br&gt;.rebrew/ga_runs.jsonl&lt;br&gt;.rebrew/solutions.json&lt;br&gt;&lt;br&gt;Winning cflags + mutation traces.&lt;br&gt;Re-running GA does not reproduce them.&lt;br&gt;Useful as seed labels, not as a byte corpus.&lt;br&gt;&lt;br&gt;verify_results.json similarity column&lt;br&gt;(resembl 0–100) is a ranking feature." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="116" width="370" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;What these are for&lt;/b&gt;&lt;br&gt;collect-pairs → mutation / score model&lt;br&gt;(how C edits change bytes)&lt;br&gt;&lt;br&gt;train.jsonl → C↔asm listing model&lt;br&gt;(Godbolt-style, vintage MSVC)&lt;br&gt;&lt;br&gt;Neither is a decompiler dataset by itself.&lt;br&gt;Ground-truth C is the EXACT/RELOC/PROVEN&lt;br&gt;sources in *-rebrew projects." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1320" y="116" width="370" height="190" as="geometry"/>
        </mxCell>

        <!-- B assemble -->
        <mxCell id="b-lane" value="B. Assemble later from project files (no new product; export scripts / a dataset pack)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="1680" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="b1m" value="&lt;b&gt;Matched-pair pack&lt;/b&gt;&lt;br&gt;Filter STATUS in {EXACT, RELOC, PROVEN}&lt;br&gt;from rebrew-functions.toml&lt;br&gt;+ .c body + CFLAGS + TOOLCHAIN&lt;br&gt;+ target bytes at VA (from the binary)&lt;br&gt;&lt;br&gt;One record = (C, flags, image, obj/target bytes).&lt;br&gt;This is the snowball ground truth.&lt;br&gt;Needs original/ or extract dumps at pack time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="386" width="400" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="b2m" value="&lt;b&gt;Near-miss pack&lt;/b&gt;&lt;br&gt;STATUS = NEAR_MATCHING&lt;br&gt;+ near-diag bucket (reg / equiv / reloc / structural)&lt;br&gt;+ BLOCKER text&lt;br&gt;+ verify match_percent + similarity&lt;br&gt;&lt;br&gt;Supervises &quot;what is still wrong&quot;,&lt;br&gt;not a finished target. Good for critic /&lt;br&gt;agent routing, bad as compile ground truth." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="386" width="400" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="b3m" value="&lt;b&gt;Context pack&lt;/b&gt;&lt;br&gt;rebrew context  (types + prototypes)&lt;br&gt;rebrew_globals.h · recover-structs&lt;br&gt;catalog names / callers (describe, xrefs)&lt;br&gt;asm.py --hints  (SEH, switch, IAT)&lt;br&gt;&lt;br&gt;This is the RAG / agent prompt payload,&lt;br&gt;not token-level compile training.&lt;br&gt;Strip secrets: no LLM keys, no original PE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="386" width="370" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="b4m" value="&lt;b&gt;External interchange&lt;/b&gt;&lt;br&gt;rebrew decompme  (upload scratch;&lt;br&gt;no automatic pull-back)&lt;br&gt;decomp.me /api/scratch scrape&lt;br&gt;(DECOMPME_SNIPPETS.md)&lt;br&gt;catalog --csv  reccmp&lt;br&gt;report --decomp-dev  report.json&lt;br&gt;objdiff.json units&lt;br&gt;&lt;br&gt;Inbound community C must be re-verified&lt;br&gt;through the pinned image before it is truth." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1320" y="386" width="370" height="190" as="geometry"/>
        </mxCell>

        <!-- C pipeline -->
        <mxCell id="c-lane" value="C. Suggested ship path (what to productize, in order)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1680" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="1. Schema freeze&lt;br&gt;version the JSONL&lt;br&gt;fields + toolchain id&lt;br&gt;+ image digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="2. Pack command&lt;br&gt;rebrew dataset export&lt;br&gt;filter STATUS, redact PE,&lt;br&gt;emit parquet/jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="660" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="3. License / filter&lt;br&gt;game binaries stay private&lt;br&gt;CRT/zlib/open-source TUs&lt;br&gt;are the public slice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="660" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="4. Join collectors&lt;br&gt;GA pairs + recompile listings&lt;br&gt;+ matched-pair pack&lt;br&gt;keyed by (compiler, flags, hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="660" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="5. Auth + retention&lt;br&gt;recompile train.jsonl&lt;br&gt;is unauthenticated;&lt;br&gt;gate before public scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="660" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="6. Train elsewhere&lt;br&gt;not in rebrew CI&lt;br&gt;LoRA / critic / mutator&lt;br&gt;then feed reagent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1240" y="660" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="7. Snowball&lt;br&gt;new EXACT pairs&lt;br&gt;re-export → retrain&lt;br&gt;relumea vision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1470" y="660" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e-c1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;endArrow=block;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;endArrow=block;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c3-ship" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c4-ship" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;dashed=1;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;dashed=1;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- D future state -->
        <mxCell id="d-lane" value="D. Future state (planned, not live). Dashed purple = does not exist yet. Each box is a product to build; none of these are how-tos." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontStyle=1;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="1680" height="430" as="geometry"/>
        </mxCell>

        <mxCell id="f-ing" value="Ingest (future)" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#581c87;" vertex="1" parent="1">
          <mxGeometry x="60" y="848" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;decomp.me dump ingest&lt;/b&gt;&lt;br&gt;official dump only&lt;br&gt;no live API scrape, no LLM on live&lt;br&gt;importer exists; dump not on disk&lt;br&gt;ai-decomp data-factory.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="872" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;dump → recompile in-image&lt;/b&gt;&lt;br&gt;C + flags from dump;&lt;br&gt;pinned MSVC6/IDO/MWCC image;&lt;br&gt;STATUS only if bytes match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="872" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;volume sources&lt;/b&gt;&lt;br&gt;AnghaBench / GitHub 1998–2005&lt;br&gt;synthetic C89 generator&lt;br&gt;always recompile in-image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="872" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;recompile auth + GC&lt;/b&gt;&lt;br&gt;gate emit_assembly&lt;br&gt;retain/rotate train.jsonl&lt;br&gt;(PRD §9 / §10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="872" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="f-pack" value="Pack (future)" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#581c87;" vertex="1" parent="1">
          <mxGeometry x="980" y="848" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="f5" value="&lt;b&gt;rebrew dataset export&lt;/b&gt;&lt;br&gt;CLI does not exist yet&lt;br&gt;filter STATUS, redact PE&lt;br&gt;task= label required&lt;br&gt;image digest on every row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d5ff;strokeColor=#7e22ce;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="872" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f6" value="&lt;b&gt;task + protocol labeled&lt;/b&gt;&lt;br&gt;task=sft | mutator | listing | critic&lt;br&gt;protocol_id on every row&lt;br&gt;train harness = eval harness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="872" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="f7" value="&lt;b&gt;public vs private slices&lt;/b&gt;&lt;br&gt;public: CRT / zlib / OSS TUs&lt;br&gt;private: game PE / NE bytes&lt;br&gt;never export unmatched STUB as truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1470" y="872" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="f-train" value="Train and close the loop (future; not in rebrew CI)" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#581c87;" vertex="1" parent="1">
          <mxGeometry x="60" y="990" width="400" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="f8" value="&lt;b&gt;Keras / JAX trainer&lt;/b&gt;&lt;br&gt;out of tree (ml-env)&lt;br&gt;score predictor&lt;br&gt;mutation classifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1014" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="f9" value="&lt;b&gt;LoRA adapters&lt;/b&gt;&lt;br&gt;per-compiler / per-game&lt;br&gt;from matched-pair SFT&lt;br&gt;relumea snowball vision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="1014" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="f10" value="&lt;b&gt;feed reagent&lt;/b&gt;&lt;br&gt;--llm-seed uses the adapter&lt;br&gt;compiler-in-the-loop still gates STATUS&lt;br&gt;LoRA is optional, verify is not" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="1014" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="f11" value="&lt;b&gt;new EXACT pairs&lt;/b&gt;&lt;br&gt;re-export → retrain&lt;br&gt;snowball. relumea owns this loop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="1014" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="f12" value="&lt;b&gt;Already usable without any of D&lt;/b&gt;&lt;br&gt;solutions.json seeds GA · --llm-seed / --kuna-seed · reagent imports rebrew.*&lt;br&gt;A trained model is optional. The pinned image is the ground-truth filter either way." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="1014" width="700" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e-f1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;dashed=1;endArrow=block;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-f2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;dashed=1;endArrow=block;" edge="1" parent="1" source="f2" target="f5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="850"/><mxPoint x="1090" y="850"/></Array></mxGeometry></mxCell>
        <mxCell id="e-f3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;dashed=1;endArrow=block;" edge="1" parent="1" source="f3" target="f5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="854"/><mxPoint x="1090" y="854"/></Array></mxGeometry></mxCell>
        <mxCell id="e-f5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;dashed=1;endArrow=block;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-f6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;dashed=1;endArrow=block;" edge="1" parent="1" source="f6" target="f8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="1004"/><mxPoint x="160" y="1004"/></Array></mxGeometry></mxCell>
        <mxCell id="e-f8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;dashed=1;endArrow=block;" edge="1" parent="1" source="f8" target="f9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-f9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;dashed=1;endArrow=block;" edge="1" parent="1" source="f9" target="f10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-f10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;dashed=1;endArrow=block;" edge="1" parent="1" source="f10" target="f11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c2-f5" value="step 2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;fontSize=9;dashed=1;endArrow=block;" edge="1" parent="1" source="c2" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- E standing rules -->
        <mxCell id="e-lane" value="E. Standing export rules (apply now and after D ships)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1260" width="1680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;task= and protocol_id&lt;/b&gt;&lt;br&gt;sft / mutator / listing / critic&lt;br&gt;unlabeled mix, or train≠eval harness, is defective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1300" width="300" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;STATUS filter&lt;/b&gt;&lt;br&gt;SFT: EXACT / RELOC / PROVEN only&lt;br&gt;never unmatched STUB as public truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="1300" width="300" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;no original game PE / NE&lt;/b&gt;&lt;br&gt;in a public set. Private packs may&lt;br&gt;keep bytes; public gets C + flags only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="1300" width="300" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;pin image digest&lt;/b&gt;&lt;br&gt;on every record. gcc-pe needs the&lt;br&gt;author's exact GCC or it is not truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1300" width="300" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;no secrets&lt;/b&gt;&lt;br&gt;REBREW_LLM_API_KEY, [llm] keys,&lt;br&gt;claim tokens stay out of JSONL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1300" width="310" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="ml-foot" value="Three corpora, three jobs: (1) matched-pair pack = decompile/codegen SFT, (2) --collect-pairs = mutator/score model, (3) recompile train.jsonl = listing model. Future-state nodes are dashed purple so they cannot be read as shipped. Research landscape (modes A/B/C, factory, lab, wiki bindings) is page 9." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1430" width="1680" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="research" name="9. AI decomp research">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1480" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="rs-title" value="Local AI decomp research and how it plugs into rebrew" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1200" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="rs-sub" value="Source of truth: ~/Desktop/ai-decomp wiki (notes, not a trainer). Archived trees in ai-decomp/!ARCHIVE/ are on-disk only, not in git. Binding: papers measure Mode A (GCC/Clang Linux re-exec). rebrew campaigns are Mode C (MSVC6/IDO/MWCC EXACT/RELOC). A 20–60% HumanEval number is not matching decompilation." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1680" height="36" as="geometry"/>
        </mxCell>

        <!-- modes -->
        <mxCell id="modes" value="Correctness modes (do not mix numbers)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="92" width="1680" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="ma" value="&lt;b&gt;Mode A — papers / lab&lt;/b&gt;&lt;br&gt;GCC/Clang Linux x86_64 -O0..-O3&lt;br&gt;HumanEval-Decompile re-exec / BLEU&lt;br&gt;Decompile-Bench, ExeBench, SK²&lt;br&gt;Never train on HE / MBPP-C / GitHub2025" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="128" width="520" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="mb" value="&lt;b&gt;Mode B — readability / types&lt;/b&gt;&lt;br&gt;R2I, ident/struct heads, Ghidra pseudo&lt;br&gt;SK² struct and ident are two corpora&lt;br&gt;obfuscate between them" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="128" width="520" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="mc" value="&lt;b&gt;Mode C — matching campaigns&lt;/b&gt;&lt;br&gt;MSVC6 / IDO / MWCC / psyq / 65816&lt;br&gt;EXACT / RELOC via rebrew test&lt;br&gt;rebrew campaigns default eval, not train" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="128" width="540" height="84" as="geometry"/>
        </mxCell>

        <!-- local stack -->
        <mxCell id="stack" value="Local stack (wiki mermaid, compressed). Most arrows are policy, not shipped ingest." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
