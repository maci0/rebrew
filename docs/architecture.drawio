        <mxCell id="e-s3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-s4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;dashed=1;endArrow=block;" edge="1" parent="1" source="s4" target="s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="282"/><mxPoint x="480" y="282"/></Array></mxGeometry></mxCell>
