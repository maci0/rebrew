        <!-- GA -->
        <mxCell id="ga-lane" value="C. GA engine (rebrew match) when the last 5–20% is flags and expression style" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontStyle=1;fontSize=12;" vertex="1" parent="1">
