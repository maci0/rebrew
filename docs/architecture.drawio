  </diagram>

  <diagram id="toolchains" name="3. Toolchains">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="tc-title" value="How rebrew uses toolchains" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="tc-sub" value="One ToolchainSpec per compiler version. Every compile runs inside its docker image (wine / DOSBox / native binary inside); the host never executes a compiler. The recompile service serves the same images over HTTP." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1400" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="src-lane" value="Build source (sibling repo)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="380" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="tcrepo" value="&lt;b&gt;rebrew-toolchains&lt;/b&gt;&lt;br&gt;github.com/maci0/rebrew-toolchains&lt;br&gt;or REBREW_TOOLCHAINS_DIR&lt;br&gt;&lt;br&gt;base/ shared Debian digest&lt;br&gt;family/version Dockerfiles&lt;br&gt;wrapper entrypoints&lt;br&gt;sources.json (sha256 pins)&lt;br&gt;16-bit media tarballs (user-supplied)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="116" width="340" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="tccli" value="&lt;b&gt;rebrew toolchain&lt;/b&gt;&lt;br&gt;build / vendor  read that checkout&lt;br&gt;pull / smoke    operate on images&lt;br&gt;detect          diec → PDB → heuristics&lt;br&gt;status / list   registry + docker presence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a5f;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="336" width="340" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="reg-lane" value="In-process registry" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="400" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="specbox" value="&lt;b&gt;ToolchainSpec&lt;/b&gt;&lt;br&gt;image tag, compiler binary, flag style&lt;br&gt;object format (COFF / OMF16 / ELF)&lt;br&gt;bits=16 joins arch-alignment set&lt;br&gt;&lt;br&gt;Built-ins + entry points&lt;br&gt;rebrew.toolchains&lt;br&gt;+ REBREW_TOOLCHAIN_OVERLAY_DIR TOML&lt;br&gt;duplicate name = RegistryError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="116" width="360" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="resolve" value="&lt;b&gt;Resolution order&lt;/b&gt;&lt;br&gt;1. per-function TOOLCHAIN / CFLAGS&lt;br&gt;2. nearest rebrew-libraries.toml&lt;br&gt;3. project [compiler] default&lt;br&gt;&lt;br&gt;library presets fill gaps&lt;br&gt;(msvcrt-static = /MT /O2 /Gd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="336" width="360" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="run-lane" value="Execution" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="780" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="dock" value="&lt;b&gt;docker-only (every toolchain)&lt;/b&gt;&lt;br&gt;docker run --rm -v project:/work &amp;lt;image&amp;gt; &amp;lt;cc&amp;gt; &amp;lt;flags&amp;gt;&lt;br&gt;wine / DOSBox / native binary is inside the image.&lt;br&gt;&lt;br&gt;msvc 1.0–11.0 · borlandc55 · watcom (win32)&lt;br&gt;tc16 · msvc1.52 · delphi16 · gcc-pe · gcc · clang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="116" width="360" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="nat" value="&lt;b&gt;recompile service (remote)&lt;/b&gt;&lt;br&gt;POST /api/v1/compile + artifact GET&lt;br&gt;same images, backend-pinned cache id&lt;br&gt;&lt;br&gt;[compiler] recompile_url&lt;br&gt;or REBREW_RECOMPILE_URL&lt;br&gt;opt-in emit_assembly tap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="116" width="360" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="obj" value="&lt;b&gt;Object parse&lt;/b&gt;&lt;br&gt;parsers.py  COFF/ELF/Mach-O via LIEF&lt;br&gt;omf16.py    16-bit OMF (MSVC 1.52 dialect)&lt;br&gt;→ function bytes + reloc slot offsets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="308" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cmake" value="&lt;b&gt;CMake bridge&lt;/b&gt;&lt;br&gt;rebrew cmake-toolchain --out cmake/&lt;br&gt;rebrew-cmake-{cl,link,lib} wrap docker run&lt;br&gt;same images, same wineprefix flock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="308" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="smoke" value="rebrew toolchain smoke: byte-reproducible objects for every image-backed toolchain. Missing image is a hard error (rebrew toolchain build | pull). Remote backend: cache id pins (url, profile), never shared with local." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="424" width="740" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="e-repo-cli" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1d4ed8;endArrow=block;" edge="1" parent="1" source="tcrepo" target="tccli">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cli-spec" value="registers / builds" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;fontSize=10;endArrow=block;" edge="1" parent="1" source="tccli" target="specbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-spec-dock" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ca8a04;endArrow=block;" edge="1" parent="1" source="specbox" target="dock">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="108"/><mxPoint x="1060" y="108"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e-spec-nat" value="remote backend" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ca8a04;fontSize=10;endArrow=block;" edge="1" parent="1" source="specbox" target="nat">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="102"/><mxPoint x="1440" y="102"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e-dock-obj" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ca8a04;endArrow=block;" edge="1" parent="1" source="dock" target="obj">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-nat-obj" value="artifact bytes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ca8a04;fontSize=10;endArrow=block;" edge="1" parent="1" source="nat" target="obj">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="detect-lane" value="How a project picks a profile" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="1600" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;1. Detect&lt;/b&gt;&lt;br&gt;toolchain_detect.py&lt;br&gt;diec → PDB S_COMPILE3&lt;br&gt;→ codegen heuristics&lt;br&gt;(.buildid, 0f 1f nops, chkstk_ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="556" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;2. Init / cfg set&lt;/b&gt;&lt;br&gt;rebrew init --compiler msvc6|gcc-pe|…&lt;br&gt;writes [compiler] in project toml&lt;br&gt;seeds CRT / opt from detect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="556" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;3. Per-library override&lt;/b&gt;&lt;br&gt;rebrew library set&lt;br&gt;rebrew-libraries.toml walk-up&lt;br&gt;whole subtree, one image+flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="556" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;4. Per-function override&lt;/b&gt;&lt;br&gt;TOOLCHAIN / CFLAGS in metadata&lt;br&gt;flag sweep may write CFLAGS&lt;br&gt;GA uses that set as the genome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="556" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;5. Compile&lt;/b&gt;&lt;br&gt;compile_to_obj&lt;br&gt;matcher.compiler.build_candidate_obj_only&lt;br&gt;same runner, SHA-256 cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1340" y="556" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e-d1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;endArrow=block;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-d2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;endArrow=block;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-d3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;endArrow=block;" edge="1" parent="1" source="d3" target="d4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-d4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="d4" target="d5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="caveat" value="gcc-pe caveat: byte-exact match needs the author's exact GCC (the image pins one version). Modern GCC vs 4.x–7.x usually only matches structurally (resembl / rebrew diff). Document the semantic decomp and BLOCKER rather than forcing EXACT." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="736" width="1600" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

