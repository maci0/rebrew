        <mxCell id="b2d" value="&lt;b&gt;--fix-bss&lt;/b&gt;&lt;br&gt;src/&amp;lt;t&amp;gt;/bss_padding.c&lt;br&gt;_pad_&amp;lt;va&amp;gt;[N] dummy arrays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
