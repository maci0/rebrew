        <mxCell id="k3" value="&lt;b&gt;matcher_ml actuals&lt;/b&gt;&lt;br&gt;real_train_pairs.jsonl = 187 lines&lt;br&gt;two SFT runs, both overfit&lt;br&gt;GA had 48 ops, no committed ga_runs&lt;br&gt;split-by-binary rule exists because of this leak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="528" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="k4" value="&lt;b&gt;Sibling / desktop tools&lt;/b&gt;&lt;br&gt;ct-recomp  holiday matching&lt;br&gt;ghidra-cli  MCP structural ops&lt;br&gt;recompile  vintage recompile API&lt;br&gt;rebrew-go  experiment, not this package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="528" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="k5" value="&lt;b&gt;Public dumps (steal recipe, recompile)&lt;/b&gt;&lt;br&gt;Decompile-Bench 2.2M Clang-19 — not vintage gold&lt;br&gt;ExeBench / AnghaBench / SK² mix — same&lt;br&gt;decompile-ghidra-100k MIT&lt;br&gt;Never train on HumanEval-Decompile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="528" width="400" height="140" as="geometry"/>
        </mxCell>

        <!-- bindings from wiki -->
        <mxCell id="bind" value="Wiki bindings that rebrew export must keep (generate-and-train.md). Do not renegotiate mid-run." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="1680" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="b1w" value="Split by binary / function_id.&lt;br&gt;Never 80/20 inside one DLL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="754" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b2w" value="rebrew campaigns default eval.&lt;br&gt;Train needs an explicit exception&lt;br&gt;and a different eval binary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="754" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b3w" value="Named protocol_id on every row.&lt;br&gt;Train harness = eval harness.&lt;br&gt;Wrong wrapper → 59.8% becomes 0%." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="754" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b4w" value="LLM emits NEAR_MATCHING C.&lt;br&gt;GA finishes bytes.&lt;br&gt;Do not SFT #pragma optimize." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="910" y="754" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b5w" value="VAs / struct offsets via RAG or mask.&lt;br&gt;insert_noop_block out of SFT.&lt;br&gt;SK² struct/ident = two corpora." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="754" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b6w" value="License per row.&lt;br&gt;HumanEval never in train.&lt;br&gt;Mode A number ≠ Mode C." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1460" y="754" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="bnote" value="Target row (factory export): id, split, task, language, compiler, opt, arch, os, function_id, binary_id, protocol_id, head, asm_surface, license, train|eval, input.assembly, output.source, compiler_image, cflags, pragma_id, abi, view_id, damage_id, parent/child hash, score_delta, engine=ga|permuter. Studio DatasetRow is missing protocol_id and license — do not ship a shard without those." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#7f1d1d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="838" width="1630" height="52" as="geometry"/>
        </mxCell>

        <!-- first useful run -->
        <mxCell id="run" value="First useful train run (wiki: does not wait for SK² I-51)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=12;" vertex="1" parent="1">
