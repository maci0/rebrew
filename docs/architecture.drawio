        </mxCell>
        <mxCell id="mut" value="&lt;b&gt;mutator.py&lt;/b&gt;&lt;br&gt;119 mut_* ops (tree-sitter)&lt;br&gt;mutate_code / crossover&lt;br&gt;entry point rebrew.mutations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="490" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="build" value="&lt;b&gt;compiler.build_candidate_obj_only&lt;/b&gt;&lt;br&gt;compile_to_obj: image or recompile&lt;br&gt;CompileCache SHA-256&lt;br&gt;60s timeout per build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="490" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;scoring.score_candidate&lt;/b&gt;&lt;br&gt;zero reloc slots, mask reg-only&lt;br&gt;numpy byte score + capstone mnemonics&lt;br&gt;Score.total (lower is better)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="490" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="win" value="&lt;b&gt;EXACT / RELOC&lt;/b&gt;&lt;br&gt;write source + CFLAGS&lt;br&gt;update_source_status&lt;br&gt;save_solution()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1170" y="490" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="budget" value="&lt;b&gt;budget exhausted&lt;/b&gt;&lt;br&gt;keep best NEAR&lt;br&gt;ga_runs.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1430" y="490" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="flags" value="&lt;b&gt;flag_sweep&lt;/b&gt;&lt;br&gt;MSVC6_SWEEP_TIERS&lt;br&gt;quick / targeted / normal / thorough / full&lt;br&gt;rebrew match --flag-sweep-only --tier targeted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sols" value="&lt;b&gt;solutions.py&lt;/b&gt;&lt;br&gt;cross-function cflags + mutation seeds&lt;br&gt;find_similar() warms the next run&lt;br&gt;target-scoped; --extra-seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="600" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;Seeds besides mutate&lt;/b&gt;&lt;br&gt;--kuna-seed  decompiler backend&lt;br&gt;--llm-seed   llm_seed.py&lt;br&gt;reagent workflows wrap the same loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="600" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cfgged" value="&lt;b&gt;cfg_ged.py&lt;/b&gt;&lt;br&gt;basic-block graph edit distance&lt;br&gt;feeds near-diag (structural vs flag-fixable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1170" y="600" width="460" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e-ga1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ea580c;endArrow=block;" edge="1" parent="1" source="ga-src" target="mut"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ga2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;endArrow=block;" edge="1" parent="1" source="mut" target="build"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ga3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ea580c;endArrow=block;" edge="1" parent="1" source="build" target="score"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ga4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="score" target="win"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ga5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ef4444;endArrow=block;" edge="1" parent="1" source="score" target="budget"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="584"/><mxPoint x="1530" y="584"/></Array></mxGeometry></mxCell>
        <mxCell id="e-ga-loop" value="next gen" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ea580c;fontSize=10;dashed=1;endArrow=block;" edge="1" parent="1" source="score" target="mut"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="590"/><mxPoint x="415" y="590"/></Array></mxGeometry></mxCell>
        <mxCell id="e-p7-ga" value="rebrew match" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ea580c;fontSize=10;endArrow=block;" edge="1" parent="1" source="p7" target="ga-src"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="28" y="384"/><mxPoint x="28" y="530"/></Array></mxGeometry></mxCell>
        <mxCell id="e-flags-b" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;endArrow=block;" edge="1" parent="1" source="flags" target="build"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-sols-m" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ea580c;endArrow=block;" edge="1" parent="1" source="sols" target="mut"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- resembl + prove -->
        <mxCell id="res-lane" value="D. resembl (structural score) vs score_candidate (GA fitness) vs prove (semantics)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="746" width="1680" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;resembl.scoring&lt;/b&gt;&lt;br&gt;optional extra [similarity]&lt;br&gt;path-pin ../resembl&lt;br&gt;&lt;br&gt;tokenize asm: REG / IMM / MEM_SIZE&lt;br&gt;weighted shingles, MinHash&lt;br&gt;hybrid Jaccard + rapidfuzz ratio&lt;br&gt;&lt;br&gt;code_similarity() → 0–100 float&lt;br&gt;used by verify.py for every function&lt;br&gt;None if extra missing (not a fake 0)&lt;br&gt;resembl's own LSH DB is not used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="786" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;matcher.scoring (always on)&lt;/b&gt;&lt;br&gt;GA fitness, no resembl required&lt;br&gt;&lt;br&gt;byte_score (reloc-zeroed, prologue-weighted)&lt;br&gt;reloc_score · mnemonic_score · prologue_bonus&lt;br&gt;structural_similarity() for near-diag&lt;br&gt;capstone + numpy only&lt;br&gt;&lt;br&gt;similar.py is a separate clone finder&lt;br&gt;(mnemonic-histogram, not resembl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="786" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;prove.py (optional angr)&lt;/b&gt;&lt;br&gt;symbolic equivalence&lt;br&gt;&lt;br&gt;when register allocation / scheduling&lt;br&gt;will never byte-match&lt;br&gt;NEAR_MATCHING → PROVEN&lt;br&gt;honored only over legitimate byte states;&lt;br&gt;stale PROVEN is demoted on verify&lt;br&gt;&lt;br&gt;[prove] extra; missing angr is a hard skip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="786" width="340" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;STATUS meaning&lt;/b&gt;&lt;br&gt;EXACT  bytes identical&lt;br&gt;RELOC  identical after reloc mask&lt;br&gt;NEAR_MATCHING  close, not done&lt;br&gt;PROVEN  semantics, not bytes&lt;br&gt;SKIP / LIBRARY  out of scope&lt;br&gt;STUB  skeleton only&lt;br&gt;&lt;br&gt;MATCH_TYPES.md has the byte examples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1360" y="786" width="330" height="160" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="backflow" name="5. Reverse data flows">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1380" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="bf-title" value="How data flows back: contracts, not shared databases" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="bf-sub" value="Solid arrows write into a rebrew project (metadata, sources, coverage.db). Dashed arrows are consume-only. Grey boxes never write STATUS. Relumea / ML snowball / recondb are vision, not shipped." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1600" height="24" as="geometry"/>
        </mxCell>

        <!-- Project hub -->
        <mxCell id="hub" value="*-rebrew project (guild-rebrew, win2k-notepad-rebrew, … under rebrew-projects/)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="800" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="h-src" value="&lt;b&gt;C sources&lt;/b&gt;&lt;br&gt;FUNCTION: markers&lt;br&gt;file-only VA/MODULE/SYMBOL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="116" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h-meta" value="&lt;b&gt;rebrew-functions.toml&lt;/b&gt;&lt;br&gt;STATUS CFLAGS BLOCKER&lt;br&gt;0444; CLI writers only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="116" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h-db" value="&lt;b&gt;db/coverage.db&lt;/b&gt;&lt;br&gt;+ data_*.json&lt;br&gt;schema: DB_FORMAT.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="116" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h-ga" value="&lt;b&gt;ga_runs.jsonl&lt;/b&gt;&lt;br&gt;solutions DB&lt;br&gt;seeds next match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1090" y="116" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h-note" value="One project = one binary. Durable facts live here. Siblings either read these files or shell/import rebrew to rewrite them. Nothing else owns STATUS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="760" height="70" as="geometry"/>
        </mxCell>

        <!-- Coverage reverse -->
        <mxCell id="cov-lane" value="1. Coverage dashboard (recoverage) — file contract + regen subprocess" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1680" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="cov1" value="rebrew catalog --json&lt;br&gt;→ db/data_*.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cov2" value="rebrew build-db&lt;br&gt;→ db/coverage.db" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="350" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cov3" value="&lt;b&gt;recoverage serve&lt;/b&gt;&lt;br&gt;Bottle + VanJS defrag grid&lt;br&gt;imports nothing from rebrew" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="350" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cov4" value="&lt;b&gt;POST /api/regen&lt;/b&gt;&lt;br&gt;or recoverage serve --regen&lt;br&gt;uv run rebrew catalog + build-db&lt;br&gt;rewrites coverage.db in-place" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="350" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cov5" value="recoverage check / stats&lt;br&gt;CI gate, read-only&lt;br&gt;rebrew dashboard.py also reads db" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="350" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cov6" value="Does not write STATUS&lt;br&gt;or touch .c files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#1e293b;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1440" y="350" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e-c1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;endArrow=block;" edge="1" parent="1" source="cov1" target="cov2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;endArrow=block;" edge="1" parent="1" source="cov2" target="cov3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c3" value="rebuild" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ca8a04;fontSize=10;endArrow=block;" edge="1" parent="1" source="cov4" target="cov1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="442"/><mxPoint x="160" y="442"/></Array></mxGeometry></mxCell>
        <mxCell id="e-c4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;dashed=1;endArrow=block;" edge="1" parent="1" source="cov3" target="cov5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="448"/><mxPoint x="1270" y="448"/></Array></mxGeometry></mxCell>
        <mxCell id="e-hdb-c" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;endArrow=block;" edge="1" parent="1" source="h-db" target="cov3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- BinSync + Ghidra -->
        <mxCell id="bs-lane" value="2. Collaboration: BinSync (fields) and Ghidra ReVa MCP (structure only)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#1e293b;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="1680" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="bs1" value="rebrew binsync-export&lt;br&gt;functions/*.toml&lt;br&gt;global_vars.toml · structs/*.toml&lt;br&gt;[rebrew] STATUS/CFLAGS as comments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="bs2" value="&lt;b&gt;BinSync state dir&lt;/b&gt;&lt;br&gt;plain TOML, no libbs&lt;br&gt;IDA · Binary Ninja · Ghidra plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="520" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="bs3" value="rebrew binsync-import&lt;br&gt;names, prototypes, global labels&lt;br&gt;--accept-binsync / --accept-local&lt;br&gt;writes metadata + source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="520" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="bs4" value="binsync-diff&lt;br&gt;read-only CI gate&lt;br&gt;exit 1 on divergence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="520" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="bs5" value="&lt;b&gt;rebrew sync (ReVa MCP)&lt;/b&gt;&lt;br&gt;create-function, bookmarks, data&lt;br&gt;not the field store&lt;br&gt;interactive Ghidra only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="520" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="bs6" value="cross-import&lt;br&gt;matched funcs from&lt;br&gt;another *-rebrew target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1460" y="520" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e-bs1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;endArrow=block;" edge="1" parent="1" source="h-meta" target="bs1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-bs2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;endArrow=block;" edge="1" parent="1" source="bs1" target="bs2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-bs3" value="plugins rename" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;fontSize=10;endArrow=block;startArrow=block;startFill=1;" edge="1" parent="1" source="bs2" target="bs3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-bs4" value="apply" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ca8a04;fontSize=10;endArrow=block;" edge="1" parent="1" source="bs3" target="h-meta"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-bs5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ca8a04;endArrow=block;" edge="1" parent="1" source="bs3" target="h-src"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- External GUIs / reccmp -->
        <mxCell id="ext-lane" value="3. External GUIs and reccmp (mostly consume; objdiff compiles back through rebrew)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1680" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="ex1" value="&lt;b&gt;rebrew objdiff&lt;/b&gt;&lt;br&gt;synthesized target COFF + objdiff.json&lt;br&gt;rebrew-objdiff-build = custom_make&lt;br&gt;compiles base .obj via same toolchain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="710" width="300" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="ex2" value="&lt;b&gt;rebrew decompme&lt;/b&gt;&lt;br&gt;upload COFF + C seed + context&lt;br&gt;claim_token URL; anonymous create&lt;br&gt;no automatic pull back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="710" width="280" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="ex3" value="&lt;b&gt;reccmp&lt;/b&gt;&lt;br&gt;markers in .c, catalog --csv&lt;br&gt;recomp build reads the tree&lt;br&gt;round-trip splices matched funcs into PE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="710" width="300" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="ex4" value="&lt;b&gt;report --decomp-dev&lt;/b&gt;&lt;br&gt;objdiff-format report.json&lt;br&gt;static HTML site also emitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="710" width="280" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="ex5" value="Human copies improved C&lt;br&gt;from decomp.me / objdiff&lt;br&gt;then rebrew test promotes STATUS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="710" width="300" height="96" as="geometry"/>
        </mxCell>

        <!-- Services / agent / ML -->
        <mxCell id="svc-lane" value="4. Services, agent, similarity, ML (what actually writes back vs what only consumes)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#9d174d;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1680" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="sv1" value="&lt;b&gt;recompile&lt;/b&gt;&lt;br&gt;POST /api/v1/compile&lt;br&gt;path-dep: rebrew.toolchain catalog&lt;br&gt;docker run same images&lt;br&gt;artifacts/{id} + ledger.json&lt;br&gt;emit_assembly → train_data/train.jsonl&lt;br&gt;&lt;br&gt;Does not read a project.&lt;br&gt;Does not write STATUS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#db2777;fontColor=#9d174d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="sv2" value="&lt;b&gt;reagent&lt;/b&gt;&lt;br&gt;in-process rebrew.* imports&lt;br&gt;skip / ga_only / llm_then_ga /&lt;br&gt;flag_sweep_first / llm_only&lt;br&gt;own SQLite run log&lt;br&gt;&lt;br&gt;Writes STATUS/CFLAGS through&lt;br&gt;the same metadata writers.&lt;br&gt;This is the live reverse path&lt;br&gt;for the LLM loop.&lt;br&gt;(sibling listed; not in this workspace checkout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="890" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="sv3" value="&lt;b&gt;resembl&lt;/b&gt;&lt;br&gt;rebrew imports resembl.scoring only&lt;br&gt;fills verify_results.similarity&lt;br&gt;&lt;br&gt;resembl CLI has its own LSH DB&lt;br&gt;(SQLite/Postgres/…). rebrew never&lt;br&gt;indexes functions into it.&lt;br&gt;&lt;br&gt;One-way library call.&lt;br&gt;No writeback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#db2777;fontColor=#9d174d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="890" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="sv4" value="&lt;b&gt;Within-project feedback&lt;/b&gt;&lt;br&gt;solutions.py seeds later GA runs&lt;br&gt;ga_runs.jsonl is history&lt;br&gt;verify demotes stale PROVEN&lt;br&gt;library / FLIRT marks SKIP&lt;br&gt;&lt;br&gt;rebrew-flirt-sigs and&lt;br&gt;rebrew-toolchains are consume-only&lt;br&gt;(images + .sig/.pat in; nothing out)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="890" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="sv5" value="&lt;b&gt;Not shipped (vision)&lt;/b&gt;&lt;br&gt;relumea SaaS workbench&lt;br&gt;recondb placeholder&lt;br&gt;decompedia wiki (markdown only)&lt;br&gt;ML_TRAINING.md snowball / LoRA&lt;br&gt;&lt;br&gt;Intended later: matched pairs +&lt;br&gt;recompile train.jsonl → fine-tune&lt;br&gt;→ reagent. Do not document as live." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#1e293b;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="890" width="310" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="legend2" value="Amber boxes write into the project. White/pink/grey boxes consume or are vision. Graph is acyclic at the repo layer: toolchains/resembl → rebrew → recoverage/recompile; reagent imports rebrew; relumea sits above and is not a dependency." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1148" width="1680" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="see2" value="Workspace: rebrew, rebrew-toolchains, rebrew-flirt-sigs, rebrew-projects, resembl, recoverage, recompile, relumea, recondb, guild-rebrew. decompedia and objconv-fork live under third-party/. reagent is documented as a sibling but is not in this checkout." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1172" width="1680" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="configs" name="6. Config and store tiers">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="cf-title" value="Config files, concerns, and who may write them" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="cf-sub" value="Four tiers from METADATA.md. Canonical is the only source of non-derivable facts. Precedence for compile: CLI flags &gt; per-function metadata &gt; rebrew-libraries.toml walk-up &gt; rebrew-project.toml &gt; env &gt; defaults." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1650" height="24" as="geometry"/>
        </mxCell>

        <!-- T0 canonical -->
        <mxCell id="t0" value="Tier 0  Canonical (user-owned). Identity in .c; volatile fields in locked TOML. Hand-edit only rebrew-project.toml and (via CLI) the three metadata TOMLs." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1680" height="430" as="geometry"/>
        </mxCell>

        <mxCell id="proj" value="&lt;b&gt;rebrew-project.toml&lt;/b&gt;  (project root; config.py)&lt;br&gt;Hand-edit + rebrew cfg / init / cmake-toolchain / gen-layout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="800" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="p-proj" value="&lt;b&gt;[project]&lt;/b&gt;&lt;br&gt;default_target · name · jobs&lt;br&gt;db_dir · output_dir · shared_dir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="168" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p-tgt" value="&lt;b&gt;[targets.&amp;lt;name&amp;gt;]&lt;/b&gt;&lt;br&gt;binary · format · arch · marker&lt;br&gt;reversed_dir · function_list · bin_dir&lt;br&gt;source_ext · library_modules · origins&lt;br&gt;crt_sources · ghidra_program_path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="168" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p-cc" value="&lt;b&gt;[compiler]&lt;/b&gt;&lt;br&gt;profile · includes · libs&lt;br&gt;cflags · base_cflags · timeout&lt;br&gt;recompile_url · recompile_emit_assembly&lt;br&gt;cflags_presets (GAME=/O2 …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="168" width="230" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="p-tcc" value="&lt;b&gt;[targets.&amp;lt;t&amp;gt;.compiler]&lt;/b&gt;&lt;br&gt;per-target profile/cflags override&lt;br&gt;unspecified keys fall back global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="270" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p-cache" value="&lt;b&gt;[cache]&lt;/b&gt;&lt;br&gt;backend = diskcache (or plugin)&lt;br&gt;keying is NOT pluggable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="270" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p-llm" value="&lt;b&gt;[llm]&lt;/b&gt;&lt;br&gt;llm_endpoint · llm_api_key&lt;br&gt;prefer env over committing the key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="270" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p-link" value="&lt;b&gt;[link] + [targets.&amp;lt;t&amp;gt;.layout]&lt;/b&gt;&lt;br&gt;file_align · stack_* · tsaware · timestamp&lt;br&gt;layout copy for UI + bss calibration&lt;br&gt;written by gen-layout / calibrate-bss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="356" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p-note" value="Fail-fast: missing [targets], empty binary. Unknown keys warn. format/arch/profile fall back (pe / x86_32 / msvc6). --target selects among [targets.*]. command/runner keys are retired (ignored)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="356" width="370" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="fn" value="&lt;b&gt;rebrew-functions.toml&lt;/b&gt;&lt;br&gt;cfg.metadata_dir (parent of reversed_dir)&lt;br&gt;key: MODULE.0xVA&lt;br&gt;mode 0444; never hand-edit&lt;br&gt;&lt;br&gt;STATUS CFLAGS TOOLCHAIN SKIP&lt;br&gt;GLOBALS BLOCKER BLOCKER_DELTA&lt;br&gt;SOURCE NOTE GHIDRA ANALYSIS&lt;br&gt;PROVE_CONSTRAINTS SIZE (override)&lt;br&gt;&lt;br&gt;Writers: test / verify / prove (STATUS)&lt;br&gt;blocker set/clear · diff --fix-blocker&lt;br&gt;near-diag --fix-blocker · document-unmatched&lt;br&gt;update_field / remove_field" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="120" width="260" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="dt" value="&lt;b&gt;rebrew-data.toml&lt;/b&gt;&lt;br&gt;same metadata_dir, no walk-up&lt;br&gt;key: MODULE.0xVA&lt;br&gt;mode 0444; never hand-edit&lt;br&gt;&lt;br&gt;name · size · section · note&lt;br&gt;for DATA / GLOBAL markers&lt;br&gt;&lt;br&gt;Writers: rebrew data&lt;br&gt;(scan / annotate / --fix-bss)&lt;br&gt;rebrew sync --pull-data&lt;br&gt;data_metadata.set_data_field" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="250" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="lb" value="&lt;b&gt;rebrew-libraries.toml&lt;/b&gt;&lt;br&gt;at a source subtree root&lt;br&gt;walk-up from the .c file&lt;br&gt;&lt;br&gt;toolchain + cflags for the&lt;br&gt;whole library (zlib, CRT, …)&lt;br&gt;presets fill gaps&lt;br&gt;(msvcrt-static = /MT /O2 /Gd)&lt;br&gt;&lt;br&gt;Writer: rebrew library set/rm&lt;br&gt;&lt;br&gt;&lt;b&gt;.c markers (file-only)&lt;/b&gt;&lt;br&gt;// FUNCTION|LIBRARY|STUB|DATA|GLOBAL:&lt;br&gt;MODULE 0xVA&lt;br&gt;optional // SIZE: N (reccmp contract)&lt;br&gt;inline STATUS/CFLAGS → lint W019&lt;br&gt;&lt;br&gt;library_*.h = LIBRARY headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1430" y="120" width="270" height="370" as="geometry"/>
        </mxCell>

