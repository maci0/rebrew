        <mxCell id="cmp" value="&lt;b&gt;CompareResult&lt;/b&gt;&lt;br&gt;matched · status · match_percent · delta&lt;br&gt;obj_bytes · reloc_offsets · similarity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="110" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;update_source_status&lt;/b&gt;&lt;br&gt;EXACT / RELOC / NEAR_MATCHING / MISMATCH&lt;br&gt;metadata only; never rewrite .c markers&lt;br&gt;rebrew test (single) · verify (batch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1360" y="100" width="330" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="diff" value="&lt;b&gt;diff / near-diag / match&lt;/b&gt;&lt;br&gt;byte + mnemonic diffs&lt;br&gt;NEAR_MATCHING buckets&lt;br&gt;GA + flag sweep (page 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="220" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="prove" value="&lt;b&gt;prove.py (optional angr)&lt;/b&gt;&lt;br&gt;NEAR_MATCHING → PROVEN&lt;br&gt;when bytes will never match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
