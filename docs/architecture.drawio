          <mxGeometry x="320" y="808" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="wrong global VA / BSS gap&lt;br&gt;→ leftover ~~ after mask&lt;br&gt;near-diag: reloc bucket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="808" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="fix data.toml / padding /&lt;br&gt;externs / fill-data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="808" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="re-verify functions&lt;br&gt;STATUS may become RELOC/EXACT&lt;br&gt;without touching the C body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="808" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="coverage document globals&lt;br&gt;section coverage for .data/.bss&lt;br&gt;separate from .text coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="808" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m-note" value="rebrew-data-analysis skill: scan → annotate → dispatch → BSS check → fix-bss / externs → gen-header → lint. Do not use it for function bodies (workflow/matching) or Ghidra field sync (ghidra-sync). recover-structs is a sibling path: typedefs from decompiler offset evidence, not from section bytes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#7c2d12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="894" width="1630" height="48" as="geometry"/>
