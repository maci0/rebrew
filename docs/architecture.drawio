          <mxGeometry x="860" y="80" width="780" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="dock" value="&lt;b&gt;docker-only (every toolchain)&lt;/b&gt;&lt;br&gt;docker run --rm -v project:/work &amp;lt;image&amp;gt; &amp;lt;cc&amp;gt; &amp;lt;flags&amp;gt;&lt;br&gt;wine / DOSBox / native binary is inside the image.&lt;br&gt;&lt;br&gt;msvc 1.0–11.0 · borland-5.5 · watcom (win32)&lt;br&gt;borland-3.1 · msvc-1.52 · delphi-1.0 · mingw-16.2.0 · gcc · clang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="116" width="360" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="nat" value="&lt;b&gt;Optional remote compiler backend&lt;/b&gt;&lt;br&gt;Configured through Rebrew compiler settings&lt;br&gt;Backend identity is included in cache keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="116" width="360" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="obj" value="&lt;b&gt;Object parse&lt;/b&gt;&lt;br&gt;parsers.py  COFF/ELF/Mach-O via LIEF&lt;br&gt;formats/omf16.py    16-bit OMF (MSVC 1.52 dialect)&lt;br&gt;→ function bytes + reloc slot offsets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="308" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cmake" value="&lt;b&gt;CMake bridge&lt;/b&gt;&lt;br&gt;rebrew cmake-toolchain --output cmake/&lt;br&gt;rebrew cmake-driver &lt;cl|link|lib&gt; -- wrap docker run&lt;br&gt;same images, same wineprefix flock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="308" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="smoke" value="rebrew toolchain smoke: byte-reproducible objects for every image-backed toolchain. Missing image is a hard error (rebrew toolchain build | pull). Remote backend: cache id pins (url, profile), never shared with local." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="424" width="740" height="56" as="geometry"/>
        </mxCell>

