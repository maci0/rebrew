        <!-- archives / desktop -->
        <mxCell id="desk" value="On this machine (not rebrew dependencies)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="1680" height="200" as="geometry"/>
