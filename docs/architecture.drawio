  <diagram id="data" name="7. Data, globals, layout">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1280" math="0" shadow="0">
      <root>
