        </mxCell>
        <mxCell id="da-sub" value="Function matching is .text. Reloc diffs (~~) are usually missing globals, BSS gaps, or linker placement. rebrew data + layout/ + postlink are the data-side workbench." style="text;html=1;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1650" height="24" as="geometry"/>
