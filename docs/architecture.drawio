<mxfile host="app.diagrams.net" modified="2026-09-09T00:00:00.000Z" agent="rebrew" version="22.1.16" type="device">
  <diagram id="ecosystem" name="1. Ecosystem">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="eco-title" value="Relumea workspace: how rebrew talks to siblings and external tools" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="eco-sub" value="Contracts are files, docker images, and a few Python imports. Nothing in this picture is a shared database except coverage.db (rebrew writes, recoverage reads)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1200" height="24" as="geometry"/>
        </mxCell>

        <!-- L0 -->
        <mxCell id="l0" value="L0  Toolchain layer (build source + images). rebrew never vendors compiler binaries." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="76" width="1600" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="rt" value="&lt;b&gt;rebrew-toolchains&lt;/b&gt;&lt;br&gt;Dockerfiles · wrappers · sources.json&lt;br&gt;sibling checkout (REBREW_TOOLCHAINS_DIR)&lt;br&gt;35 compiler images, sha256-pinned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="64" y="112" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="img" value="&lt;b&gt;docker images&lt;/b&gt;&lt;br&gt;rebrew/msvc:6.0-win32 (wine in image)&lt;br&gt;rebrew/borland:5.5-win32 · 3.1-win16&lt;br&gt;rebrew/msvc:1.52-win16 · delphi:1.0-win16&lt;br&gt;watcom win32, …  Missing image = hard error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="112" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="native" value="&lt;b&gt;All images, no host compilers&lt;/b&gt;&lt;br&gt;rebrew/gcc:pe-win32 (MinGW PE)&lt;br&gt;rebrew/gcc:linux-x64 · clang:linux-x64&lt;br&gt;rebrew/watcom:2.0-win16 (wcc)&lt;br&gt;native binaries run INSIDE images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a5f;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="112" width="300" height="110" as="geometry"/>
