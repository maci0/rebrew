        <mxCell id="k1" value="&lt;b&gt;~/Desktop/ai-decomp&lt;/b&gt;&lt;br&gt;MkDocs wiki. Notes only.&lt;br&gt;wiki/decomp/* is the playbook&lt;br&gt;generate-and-train.md = resume page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;align=center;fontSize=11;" vertex="1" parent="1">
