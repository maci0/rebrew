        <!-- layout / postlink -->
        <mxCell id="lay" value="C. Layout package and postlink (linker artifacts, not decomp errors)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="1680" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="l0" value="&lt;b&gt;rebrew gen-layout&lt;/b&gt;&lt;br&gt;from reference PE&lt;br&gt;text-only package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;layout/&amp;lt;target&amp;gt;/&lt;/b&gt;&lt;br&gt;rebrew-layout.toml  sections, IAT, exports&lt;br&gt;header.hex iat.hex data.hex reloc.hex&lt;br&gt;prefix.hex bookkeeping.hex&lt;br&gt;operands.txt calls.txt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="548" width="280" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;link helpers&lt;/b&gt;&lt;br&gt;gen-link-stubs  BSS TU&lt;br&gt;gen-stubs  unresolved symbols&lt;br&gt;&amp;lt;t&amp;gt;.def  export ordinals&lt;br&gt;link-sweep  LINK.EXE flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="548" width="240" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;round-trip / recomp&lt;/b&gt;&lt;br&gt;splice matched funcs into PE&lt;br&gt;--fix-headers uses [link]&lt;br&gt;naked-fenced sources for reccmp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="548" width="250" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;rebrew postlink&lt;/b&gt;&lt;br&gt;built.dll vs layout/ (or ref)&lt;br&gt;--fix imports | data | pe-metadata | all&lt;br&gt;order: imports → data → pe-metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="548" width="280" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l5" value="&lt;b&gt;byte-identical PE&lt;/b&gt;&lt;br&gt;linker hash/IAT/timestamp&lt;br&gt;normalized away;&lt;br&gt;remaining diff is real code/data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1440" y="548" width="250" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="l-note" value="MSVC6 LINK is not a source-order assembler for every section. Placement drift is a linker artifact. The layout package is committed so a public checkout reproduces postlink without original/. Prefix hex is checked for drift, never copied." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="668" width="1630" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="e-l0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="l0" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-l1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-l3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="l1" target="l4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="512"/><mxPoint x="1270" y="512"/></Array></mxGeometry></mxCell>
