<div class='{% if bottom %}pager pager-end{% else %}pager{% endif %}' aria-label='{{ label }}' role='group'>Showing {{ start }}–{{ end }} of {{ total_rows }} {{ noun }}{% if span %} ({{ span }}){% endif %}. {% for item in items %}{% if not loop.first %} · {% endif %}{% if item.current %}<span class='here' aria-current='page'>{{ item.text }}</span>{% else %}<a href='{{ item.href }}' aria-label='{{ item.aria_label }}'>{{ item.text }}</a>{% endif %}{% endfor %}</div>
