# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv*/
# Commit .python-version so local uv/python match CI's default (3.12).
# Do not ignore it: an untracked pin cannot be shared or enforced.

# IDE / tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.claude/
.opencode/
.review-loop.lock
.gauntlet.lock

# Build artifacts
*.egg-info/
dist/
build/

# Recoverage generated data
recoverage/data.json
recoverage/data_*.json
recoverage/server_functions.csv
recoverage/coverage.db
recoverage/coverage.db-shm
recoverage/coverage.db-wal
recoverage/__pycache__/

# Generated files
.slim/
codemap.md
src/codemap.md
src/rebrew/codemap.md
src/rebrew/matcher/codemap.md
CLAUDE.md
cli_helps.txt
# Root agent-skills/ is generated by rebrew-init from the package copy
/agent-skills/

# Coverage
.coverage
*.cover
htmlcov/

# Local tool dumps
verify_results.json
*.reasm

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# OS
.DS_Store
Thumbs.db

# Vendored Detect It Easy (diec) — optional; detection falls back to PATH diec
/tools/diec/

# wibo — lightweight Win32 PE loader (auto-downloaded by init/doctor/CI; see
# src/rebrew/wibo.py).  Kept out of git; re-download or build from
# github.com/decompals/wibo.
/tools/wibo

# Vendored MSVC toolchain downloads (docs/TOOLCHAIN.md: "kept out of git").
# Re-fetch/extract from github.com/OmniBlade/decomp.me msvcwin9x releases.
/tools/msvc6.3/
/tools/msvc6.6/
/tools/msvc7.0/
/tools/msvc6.3.tar.gz
/tools/msvc6.6.tar.gz
/tools/msvc7.0.tar.gz
# Local full-product toolchain checkouts (VC 4.2 / 5.0 — user-provided).
/tools/MSVC420/
/tools/MSVC500/
# Debug/build cruft that can appear inside vendored toolchains
*.pdb
*.dbg
*.bsc
*.map
# Cross-process metadata write lock (flock sidecar — must persist)
rebrew-functions.toml.lock

# Vendored Open Watcom 2.0 (tools/WATCOM) — kept out of git.
# Re-fetch from open-watcom/open-watcom-v2 Last-CI-build ow-snapshot.tar.xz.
/tools/WATCOM/
# Vendored MSVC 1.52 (tools/MSVC152) — kept out of git.
# Re-fetch from archive.org item en_vc152_202512.
/tools/MSVC152/

# Vendored objconv (OMF→COFF converter) — kept out of git (>500KB).
# Build from github.com/gitGNU/objconv (g++ -O2 src/objconv.cpp).
/tools/objconv/

# toolchain-images build contexts (vendored toolchain copies — the
# Dockerfiles + wrappers are tracked; the staged binaries re-fetch/vendor
# elsewhere).
/toolchain-images/**/delphi10/
/toolchain-images/**/delphi-lib/
/toolchain-images/msvc/**/msvc152/

# Vendored toolchain trees under toolchain/ stay out of git — the docker
# build source (Dockerfiles, wrappers, the shared base) is no longer
# vendored in-repo at all: it lives in the sibling rebrew-toolchains repo
# (see docs/TOOLCHAIN.md).  A stray dir here is never build source.
/toolchain/

# tools/ symlinks back to the vendored toolchain/ trees are gone — the
# toolchain trees now live in the rebrew-toolchains checkout, so there is
# nothing to alias (legacy projects repoint rebrew-project.toml paths at
# the vendored trees in that checkout).

# Toolchain download cache (pinned-source tarballs, re-fetched by rebrew toolchain vendor).
/.cache/
