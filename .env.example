# =============================================================================
# Rebrew Runtime Environment Variables
# Rebrew reads the process environment only: it never loads a .env file.
# Export the variables below from your shell (or point direnv at a private
# .env, which .gitignore already excludes) before running rebrew.
# Note: Values here are placeholders; never commit real secrets or credentials.
#
# A directory-valued REBREW_* knob that names something which is not a
# directory is reported by `rebrew cfg effective` (env_errors) and by the
# command that reads it, rather than quietly doing nothing.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Seeding (Optional - used by `rebrew match run --seed-llm`)
# -----------------------------------------------------------------------------

# Base URL for the LLM chat completions endpoint (must be http(s) with host).
# For plain http, only loopback addresses (localhost, 127.0.0.1, ::1) are allowed
# when an API key is configured.
# REBREW_LLM_ENDPOINT=http://localhost:11434/v1

# Bearer API key for the LLM endpoint.
# When present in the environment (even if empty), this overrides [llm].api_key in TOML.
# REBREW_LLM_API_KEY= # printable, no control or bidi-format charsyour-api-key-here

# Pinned model identifier (e.g. gpt-4o-mini-2024-07-18).
# Floating aliases like "latest", "auto", or "default" are rejected to ensure
# reproducible seed generation.
# REBREW_LLM_MODEL=gpt-4o-mini-2024-07-18

# Process-wide ceiling on LLM HTTP calls (default: 32, max: 10000).
# Set to 0 to disable LLM calls for the process.
# Overrides [llm] max_requests for the run; unset falls through to the TOML.
# REBREW_LLM_MAX_REQUESTS=32

# Process-wide ceiling on the tokens those calls bill (default: 500000,
# max: 100000000). A call count does not price a run, so each request is
# priced before it is sent and one that no longer fits is refused. Set to 0
# to lift the ceiling. Overrides [llm] max_tokens for the run.
# REBREW_LLM_MAX_TOKENS=500000

# Per-request HTTP budget for one LLM seeding call, in seconds (default: 90,
# min: 5, max: 1800). Raise it for a local model that needs minutes for one
# capped completion; a timed-out request is still billed. Overrides [llm]
# timeout for the run. All three budget variables are parsed when a project
# config is read, so a typo fails there rather than falling back to the
# default; `rebrew cfg effective` reports the resolved values as
# llm_max_requests, llm_max_tokens, and llm_timeout. A set-but-empty one
# keeps the default, so `REBREW_LLM_TIMEOUT=` is the default, not zero.
# REBREW_LLM_TIMEOUT=90

# Set to 1 (or true/yes/on) to let an [llm] endpoint written in
# rebrew-project.toml receive REBREW_LLM_API_KEY. The project file outranks
# REBREW_LLM_ENDPOINT, so without this a checked-out project could aim the
# analyst's key at its own host. Only a project-named endpoint needs this:
# REBREW_LLM_ENDPOINT is the analyst's own and needs no opt-in.
# 0/false/no/off keeps the refusal, and any other value is a hard error
# rather than consent. Loopback endpoints (local ollama / vllm) need no
# opt-in. It picks the host, not the transport: a plain http:// project
# endpoint still needs https (or a loopback host) to carry a key.
# REBREW_LLM_ALLOW_PROJECT_ENDPOINT=1

# -----------------------------------------------------------------------------
# Remote Compile Service (Optional)
# -----------------------------------------------------------------------------

# Base URL for remote compile service (e.g. http://localhost:8000).
# When present in the environment (even if empty), this overrides [compiler].recompile_url in TOML.
# Setting to empty forces local Docker toolchains.
# REBREW_RECOMPILE_URL=http://localhost:8000

# REBREW_JOB_COMPILE_SOCKET is an internal jobs-owner setting, not a CLI knob.
# The owner sets /run/rebrew-job/owner.sock with REBREW_RECOMPILE_URL=http://rebrew-job;
# the worker receives a job-scoped socket capability, not the caller credential.

# -----------------------------------------------------------------------------
# Container Runtime & Execution
# -----------------------------------------------------------------------------

# Container CLI used for docker-shipped toolchain images.
# Supported: docker (default), podman, nerdctl. Any other bare name is an
# error; a path to the binary is accepted verbatim.
# REBREW_CONTAINER_RUNTIME=docker

# Wine headless mode (for bare host wine compilation).
# 1 (or true/yes/on) enables persistent virtual display with Xvfb (default).
# 0 (or false/no/off) disables headless mode.
# REBREW_WINE_HEADLESS=1

# Display identifier for headless virtual display (e.g. :99).
# REBREW_XVFB_DISPLAY=:99

# Auth token file of the Xvfb rebrew started. Written by rebrew next to
# REBREW_XVFB_DISPLAY so a later process can adopt the server; it holds a bare
# hex token, not an xauth record, so it does not enforce access control; not a
# knob.
# REBREW_XVFB_AUTH=/home/user/.cache/rebrew/xvfb-cookie

# Wine prefix for CMake toolchain bridge scripts (must be an absolute path).
# Default: $XDG_CACHE_HOME/rebrew-<toolchain>-wineprefix
# REBREW_WINEPREFIX=$HOME/.cache/rebrew/rebrew-msvc-6.0-wineprefix

# Toolchain profile pin for CMake bridge (e.g. msvc-6.0).  A name no
# toolchain registers is reported by `rebrew cfg effective`.
# REBREW_TOOLCHAIN=msvc-6.0

# -----------------------------------------------------------------------------
# decomp.me (Optional)
# -----------------------------------------------------------------------------

# Base URL of the decomp.me instance `rebrew export decompme` uploads to. The server
# issues a scratch claim token, which is printed and kept in the upload ledger,
# so the host that receives it is worth pinning once here rather than retyping
# --api on every invocation. Must be http(s) with a host.
# A set-but-empty value is read as unset, leaving the --api default in force.
# Default: https://decomp.me
# REBREW_DECOMPME_API=https://decomp.me

# -----------------------------------------------------------------------------
# Toolchain & Extension Paths
# -----------------------------------------------------------------------------

# Path to the sibling recompile-toolchains repository (Dockerfiles and wrappers).
# Default: sibling directory ../recompile-toolchains
# REBREW_TOOLCHAINS_DIR=../recompile-toolchains

# Directory for custom toolchain overlay TOML files.
# REBREW_TOOLCHAIN_OVERLAY_DIR=

# Path to the recondb signatures repository.
# A value that is not a directory is a hard error, not a silent drop of every
# standard-library signature. A leading ~ is expanded.
# Default: sibling directory ../recondb next to the rebrew source
# checkout. A wheel install has no checkout to find, so set this explicitly.
# REBREW_FLIRT_SIGS_DIR=../recondb

# User/community Agent Skills directory (overrides packaged skills of same name).
# REBREW_SKILLS_DIR=

# rebrew ops: the backend's local filestore directory and the workspace that
# analyse projects, report output and url downloads go in (absolute, existing
# directories), the url download cap in bytes and serve's concurrent calls.
# REBREW_OPS_FILESTORE=
# REBREW_OPS_WORKSPACE=
# REBREW_OPS_MAX_DOWNLOAD=
# REBREW_OPS_CONCURRENCY=
# REBREW_OPS_ALLOWED_HOSTS=
# Allow presigned url downloads from private/loopback hosts (SSRF bypass; leave unset for the refusal).
# REBREW_OPS_ALLOW_PRIVATE_DOWNLOAD=

# OTLP/HTTP collector base URL for rebrew ops serve spans (http(s)://host:4318); unset exports nothing.
# REBREW_OTLP_ENDPOINT=

# Bearer token rebrew ops serve requires; never pass it on the command line.
# REBREW_OPS_TOKEN=

# rebrew-jobs (Go owner): bearer token, loopback bind, workspace/job-dir and
# provider paths the owner requires at startup (see docs/CONFIG.md).
# REBREW_JOB_TOKEN=
# REBREW_JOBS_ADDR=127.0.0.1:8089
# REBREW_WORKSPACE=
# REBREW_JOB_DIR=
# REBREW_BINARY=
# REBREW_DOCKER_BINARY=
# REBREW_JOB_DOCKER_IMAGE=
# Owner-mediated managed compile upstream and its per-owner budget.
# REBREW_MANAGED_RECOMPILE_URL=
# REBREW_MANAGED_COMPILE_LIMIT=

# -----------------------------------------------------------------------------
# PE Runner
# -----------------------------------------------------------------------------

# Host PE runner path/name prepended to the compile command. Set by rebrew's
# own msvc_env from [compiler].runner and consumed by the matcher; an ambient
# value is dropped on every compile path, so exporting it changes nothing. Pin
# the runner in rebrew-project.toml ([compiler] runner = "wibo") instead.
# REBREW_COMPILER_RUNNER=wine

# PE runner used *inside* docker toolchain images (wine default, wibo opt-in).
# Not read by the host Python process.
# REBREW_RUNNER=wine

# -----------------------------------------------------------------------------
# Tooling
# -----------------------------------------------------------------------------

# Base log level for a run that passes no -v / -q.
# One of: debug, info, warning, error, critical. Default: warning.
# An explicit -v / -q outranks this. An unknown value warns and keeps the
# default; `rebrew cfg effective` names it under env_errors.
# REBREW_LOG_LEVEL=info

# Root directory scanned by tools/audit_projects.py.
# Default: the parent directory of this rebrew install.
# REBREW_PROJECTS_ROOT=../

# Shell-completion mode marker, set by the completing shell. Do not export it.
# _REBREW_COMPLETE=bash_source

# -----------------------------------------------------------------------------
# Host Tools (Optional)
# -----------------------------------------------------------------------------

# SLEIGH specs root the host `kuna` binary reads in place of the specs it
# carries (the directory holding Ghidra/Processors). A leading ~ is expanded.
# A value that is not a directory is reported by `rebrew cfg effective`
# (env_errors) and kept from kuna.
# Default: unset; kuna v1.820+ finds its own specs.
# KUNA_SPECS=/usr/share/kuna/specs


# -----------------------------------------------------------------------------
# Go Jobs Owner (rebrew-jobs, services/jobs/)
# -----------------------------------------------------------------------------

# Bearer token the Go rebrew-jobs owner requires on every request except
# liveness probes. Must be at least 32 bytes; the owner refuses to start
# without it. Never pass it on the command line.
# REBREW_JOB_TOKEN=

# Bind host:port for rebrew-jobs. Default 127.0.0.1:8089. Only a loopback
# host:port (IP-literal loopback or localhost) is accepted; a non-loopback
# or malformed value is fatal at startup.
# REBREW_JOBS_ADDR=127.0.0.1:8089

# Required by rebrew-jobs: workspace it copies/seals and private job
# directory outside it. Each must be an absolute path to an existing dir.
# REBREW_WORKSPACE=
# REBREW_JOB_DIR=

# Absolute path to the rebrew CLI for the direct job provider. A relative
# spelling is refused.
# REBREW_BINARY=

# Absolute path to docker binary for the Docker job provider. Required with
# REBREW_JOB_DOCKER_IMAGE.
# REBREW_DOCKER_BINARY=

# Docker provider image, a sha256: image id (sha256: + 64 lowercase hex).
# Required with REBREW_DOCKER_BINARY.
# REBREW_JOB_DOCKER_IMAGE=

# Managed compile: upstream for the owner-mediated managed compile path.
# Must be https, or http to 127.0.0.1/::1, with no path/query/fragment or
# credentials. Unset disables the managed path.
# REBREW_MANAGED_RECOMPILE_URL=

# Per-owner managed-compile budget, required with
# REBREW_MANAGED_RECOMPILE_URL. Int in 1..1000.
# REBREW_MANAGED_COMPILE_LIMIT=

# Allowed compilers for managed compile, required with
# REBREW_MANAGED_RECOMPILE_URL. Comma-separated, non-empty entries
# (e.g. msvc-6.0,gcc-14.2.0).
# REBREW_MANAGED_COMPILERS=

# -----------------------------------------------------------------------------
# Authentication (Optional)
# -----------------------------------------------------------------------------

# GitHub personal access token for downloading toolchain release assets.
# GH_TOKEN=
# GITHUB_TOKEN=
# Optional bearer key for an authenticated recompile service (HTTPS-only).
# REBREW_RECOMPILE_API_KEY=
# One in-cluster service host (.svc or .svc.cluster.local) that may take the key over plain HTTP.
# REBREW_RECOMPILE_INSECURE_CLUSTER_HOST=
